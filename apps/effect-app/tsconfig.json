{
	"extends": "@scraper/tsconfig/base/application.json",
	"display": "effect-app tsconfig",
	"compilerOptions": {
		"rootDir": ".",
		"baseUrl": ".",
		"exactOptionalPropertyTypes": true,
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["./**/*.ts", "./**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
