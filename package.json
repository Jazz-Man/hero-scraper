{
	"name": "scraper",
	"devDependencies": {
		"@effect/language-service": "0.23.3",
		"@tsconfig/bun": "1.0.8",
		"@types/bun": "1.3.10",
		"@types/geoip-lite": "1.4.4",
		"@types/node": "25.5.0"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0",
		"bun": ">=1.2.18"
	},
	"private": true,
	"resolutions": {
		"utf7": "npm:utf7@workspace:*"
	},
	"scripts": {
		"cloud:start": "bun --filter '@scraper/cloud' start",
		"cf:delete": "bun run src/cloudflare/delete.ts",
		"cf:create": "bun run src/cloudflare/create.ts",
		"imap:test": "bun --filter '@scraper/imapflow' test:imap"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"resolutions/*"
	],
	"dependencies": {
		"@effect/platform-bun": "4.0.0-beta.33",
		"@faker-js/faker": "10.3.0",
		"cloudflare": "5.2.0",
		"effect": "4.0.0-beta.33",
		"fingerprint-generator": "2.1.81",
		"geoip-lite": "1.4.10",
		"otpauth": "9.5.0"
	},
	"peerDependencies": {
		"typescript": "5.9.3"
	}
}
