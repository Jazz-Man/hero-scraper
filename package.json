{
  "name": "scraper",
  "devDependencies": {
    "@effect/language-service": "0.23.3",
    "@tsconfig/bun": "1.0.8",
    "@types/bun": "1.3.10",
    "@types/geoip-lite": "1.4.4",
    "@types/node": "25.5.0",
    "bun-types": "1.3.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "bun": ">=1.2.18"
  },
  "private": true,
  "resolutions": {
    "utf7": "npm:utf7@workspace:*",
    "better-sqlite3": "npm:better-sqlite3@workspace:*"
  },
  "scripts": {
    "hero:cloud": "cloud start --env=${PWD}/.env",
    "cf:delete": "bun run src/cloudflare/delete.ts",
    "cf:create": "bun run src/cloudflare/create.ts",
    "imap:test": "bun --filter '@scraper/imapflow' test:imap"
  },
  "workspaces": [
    "resolutions/*"
  ],
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.33",
    "@effect/sql-sqlite-bun": "4.0.0-beta.33",
