{
  "name": "scraper",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "bun": ">=1.1.0"
  },
  "private": true,
  "scripts": {
    "cloud:start": "bun --filter '@scraper/cloud' --bun start",
    "prereinstall:all": "find . -type d -name '*node_modules*' -exec rm -rfv {} + && bun pm cache rm && rm bun.lock 2> /dev/null || true",
    "reinstall:all": "bun install",
    "postinstall": "echo 'test'"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@ulixee/chrome-131-0",
    "@ulixee/unblocked-agent-mitm-socket",
    "esbuild",
    "prisma"
  ],
  "resolutions": {
    "better-sqlite3": "npm:better-sqlite3@workspace:*"
  }
}