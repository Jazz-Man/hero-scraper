{
  "name": "scraper",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "bun": ">=1.1.0"
  },
  "private": true,
  "scripts": {
    "cloud:start": "bun --filter '@scraper/cloud' start"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@ulixee/chrome-131-0",
    "@ulixee/unblocked-agent-mitm-socket",
    "esbuild",
    "prisma"
  ],
  "resolutions": {
    "better-sqlite3": "npm:better-sqlite3@workspace:*"
  }
}