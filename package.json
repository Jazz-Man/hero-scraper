    "effect": "4.0.0-beta.33",
    "fingerprint-generator": "2.1.81",
    "geoip-lite": "1.4.10",
    "otpauth": "9.5.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "@ulixee/hero-core@2.0.0-alpha.34": "patches/@ulixee%2Fhero-core@2.0.0-alpha.34.patch"
