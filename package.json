    "@ulixee/awaited-dom": "1.4.2",
    "@ulixee/cloud": "2.0.0-alpha.34",
    "@ulixee/commons": "2.0.0-alpha.34",
    "@ulixee/default-browser-emulator": "2.0.0-alpha.34",
    "@ulixee/execute-js-plugin": "2.0.0-alpha.34",
    "@ulixee/hero": "2.0.0-alpha.34",
    "@ulixee/hero-core": "2.0.0-alpha.34",
    "@ulixee/hero-interfaces": "2.0.0-alpha.34",
    "@ulixee/hero-playground": "2.0.0-alpha.34",
    "@ulixee/real-user-agents": "2.0.0-alpha.34",
